<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);ROSSELLA_TASKBAR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rosella.Compositor/Rosella.Compositor.csproj" Condition="'$(RosellaHostDirectory)' == ''" />
    <Reference Include="Rosella.Compositor;Rosella.Input" Condition="'$(RosellaHostDirectory)' != ''">
      <HintPath>$(RosellaHostDirectory)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="../Rosella.Compositor/Shell/TaskbarImplementation.cs" Link="TaskbarImplementation.cs" />
    <Compile Include="../Rosella.Compositor/Shell/Bar.cs" Link="Bar.cs" />
    <Compile Include="../Rosella.Compositor/Shell/TaskbarIcons.cs" Link="TaskbarIcons.cs" />
    <Compile Include="../Rosella.Compositor/Shell/SettingsPanel.cs" Link="SettingsPanel.cs" />
    <Compile Include="../Rosella.Compositor/Shell/AudioOutputPicker.cs" Link="AudioOutputPicker.cs" />
    <Compile Include="../Rosella.Compositor/Shell/SettingsSelector.cs" Link="SettingsSelector.cs" />
    <Compile Include="../Rosella.Compositor/Shell/ModulePicker.cs" Link="ModulePicker.cs" />
  </ItemGroup>

</Project>
